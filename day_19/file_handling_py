# level 1 - Exercise 2
def most_spoken_languages(filename, number_languages):
    """Returns the n most spoken languages."""
    with open(data_dir / filename, "r", encoding="utf-8") as file_handle:
        countries = json.load(file_handle)
    language_count = {}
    for country in countries:
        for language in country.get("languages", []):
            language_count[language] = language_count.get(language, 0) + 1
    return sorted(language_count.items(), key=lambda x: x[1], reverse=True)[
        :number_languages
    ]


print("Most spoken languages:", most_spoken_languages("countries_data.json", 10))


# level 1 - Exercise 3
def most_populated_countries(filename, number_countries):
    """Returns the n most populated countries."""
    with open(data_dir / filename, "r", encoding="utf-8") as file_handle:
        countries = json.load(file_handle)
    return sorted(countries, key=lambda x: x.get("population", 0), reverse=True)[
        :number_countries
    ]


print("Most populated countries:", most_populated_countries("countries_data.json", 3))


# Level 2 - Exercise 1
def extract_email_addresses(filename):
    """Extracts all incoming email addresses as a list from the email_exchange_big.txt file."""
    with open(data_dir / filename, "r", encoding="utf-8") as file_handle:
        email_data = file_handle.read()
    email_addresses = []
    for line in email_data.splitlines():
        if "From:" in line:
            email_address = line.split("From:")[1].strip()
            email_addresses.append(email_address)
    return email_addresses


print("Extracted email addresses:", extract_email_addresses("email_exchanges_big.txt"))
